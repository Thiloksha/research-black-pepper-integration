# Combined environment examples for both MongoDB and PostgreSQL setups.
# Copy to .env and replace placeholder values.

# MongoDB (if using MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/black_pepper_db

# PostgreSQL (if using Prisma/Postgres)
# Example PostgreSQL URL: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Cloudinary credentials (used for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: change the server port
PORT=5000
